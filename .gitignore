# macOS / Windows metadata
.DS_Store
Thumbs.db

# Editor temporary files
*.swp
*.swo
*~
*.tmp

# In-repo agent-filename symlinks created by bin/install.sh.
# These are per-checkout (created locally on install) and should not be
# tracked in the repo.  They all symlink to AGENTS.md.
/CLAUDE.md
/.cursorrules
/CONVENTIONS.md
/GEMINI.md
/AGENT.md

# uninstall.sh log file (only present after running uninstall.sh)
.scicomp-research-skills.uninstall.log

# Skills written into skills/ by OTHER tools. install.sh points the
# user-level skill directories (~/.claude/skills, ~/.agents/skills,
# ~/.config/opencode/skills, ...) at this repo's skills/, so anything a
# client installs "user-wide" lands here. Not ours; never commit it.
#   synced/          Claude desktop app skill sync (Anthropic skills)
#   frontend-design/ copied from the Claude Code frontend-design plugin
/skills/synced/
/skills/frontend-design/
